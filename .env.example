# Copie este arquivo para .env (local) e configure as variáveis na Vercel
# (Project Settings > Environment Variables). NÃO commitar o .env real.

# String de conexão do Neon (Postgres). Use a connection string "pooled"
# para a aplicação e inclua sslmode=require. Exemplo de formato:
# postgresql://USUARIO:SENHA@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# (Opcional) Conexão direta (não-pooled) para rodar migrações com o Prisma.
# No Neon, é a connection string sem o "-pooler" no host.
DIRECT_URL=

# Email do único administrador autorizado a gerenciar fotos.
ADMIN_EMAIL=bostelmann@gmail.com

# Hash bcrypt da senha do admin. Gerado pelo script da FEAT-003.
# NUNCA coloque a senha em texto puro aqui nem em qualquer arquivo.
ADMIN_PASSWORD_HASH=

# Segredo para assinar o cookie de sessão (iron-session).
# Use uma string aleatória com pelo menos 32 caracteres.
SESSION_SECRET=
